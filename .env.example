# =============================================================================
# Gestionnaire d'abonnements — variables d'environnement (aucun secret réel ici)
# =============================================================================
# Copier ce fichier :
#   - vers apps/api/prisma/.env (lu par la CLI Prisma : generate / migrate / seed,
#                                depuis la racine comme depuis apps/api)
#   - vers apps/api/.env.local (lu par Next.js à l'exécution)
# Les deux sont ignorés par git.

# --- Pages publiques légales (CLAUDE.md §2.2) --------------------------------
# Valeurs PUBLIQUES uniquement : Next.js les inline dans le bundle des pages.
# Aucun secret ne doit jamais être préfixé NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL="https://example.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_COMPANY_NAME="Gestionnaire d'abonnements"
# Date de dernière révision affichée sur les documents légaux (YYYY-MM-DD).
NEXT_PUBLIC_LEGAL_UPDATED_AT="2026-08-29"

# --- Base de données (specs/schema-donnees.md §1) ----------------------------
# URL applicative (peut passer par un pooler type PgBouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_manager?schema=public"
# Connexion directe, utilisée par les migrations Prisma (jamais via un pooler).
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_manager?schema=public"

# --- Sessions & tokens (specs/auth-comptes-rgpd.md §4-§5) --------------------
# Les tokens opaques sont stockés hachés en SHA-256 : il n'y a aucun secret de
# session à configurer. Seules leurs durées de vie sont paramétrables.
# Durée de vie d'une session, en jours (fenêtre glissante). Défaut : 90.
AUTH_SESSION_TTL_DAYS="90"
# Durée de vie d'un token de réinitialisation, en minutes. Défaut : 30.
AUTH_PASSWORD_RESET_TTL_MINUTES="30"

# --- E-mail transactionnel (reset de mot de passe) ---------------------------
# "noop"    : n'envoie rien (défaut). En développement (next dev), l'e-mail
#             est tout de même affiché dans le terminal, comme avec "console" ;
# "console" : affiche l'e-mail complet dans le terminal de l'API — objet,
#             lien de réinitialisation et jeton, chacun seul sur sa ligne —
#             au lieu de l'envoyer. REFUSÉ en production (le lien contient le
#             token brut) ;
# "resend"  : envoie réellement par l'API HTTP du fournisseur — seule valeur
#             acceptée en production.
EMAIL_PROVIDER="noop"
# Clé d'API du fournisseur. SECRET : jamais préfixée NEXT_PUBLIC_ / EXPO_PUBLIC_,
# jamais journalisée. Obligatoire avec EMAIL_PROVIDER="resend".
EMAIL_PROVIDER_API_KEY=""
# Expéditeur, au format "Nom <adresse>" ou "adresse". Le domaine doit être
# vérifié chez le fournisseur. Obligatoire avec EMAIL_PROVIDER="resend".
EMAIL_FROM=""
# Adresse de réponse. Vide = les réponses vont à EMAIL_FROM.
EMAIL_REPLY_TO=""
# Base de l'API du fournisseur (à surcharger pour un proxy interne ou un test).
EMAIL_API_BASE_URL="https://api.resend.com"
# Délai maximal d'un envoi, en millisecondes.
EMAIL_REQUEST_TIMEOUT_MS="10000"
# Base du lien de réinitialisation (deep link ouvert par l'application mobile).
PASSWORD_RESET_URL_BASE="subscription-manager://reset-password"

# --- Magasins partagés entre instances (CLAUDE.md §10.11, §10.14) ------------
# "memory"   : par process — développement et tests uniquement ;
# "postgres" : partagé — OBLIGATOIRE en production. Le serveur refuse de
#              démarrer avec "memory" (src/instrumentation.ts).
#
# Laisser ces deux variables NON DÉFINIES suffit : elles valent "memory" hors
# production et "postgres" en production (Vercel compris). Ne pas recopier
# "memory" dans la configuration d'un hébergeur : le démarrage serait refusé.
# "postgres" exige la migration 20260906120000_shared_stores sur la base.
#
# Pourquoi : en mémoire, N instances autorisent N fois la limite de rate
# limiting, et une confirmation d'import qui atterrit sur une autre instance ne
# retrouve pas son aperçu.
# RATE_LIMIT_STORE="postgres"
# IMPORT_PREVIEW_STORE="postgres"

# --- Import de relevés (specs/import-releves.md §3) --------------------------
# Taille maximale d'un fichier importé, en octets (défaut : 10 MiB).
MAX_IMPORT_FILE_SIZE_BYTES="10485760"
# Nombre maximal de lignes de données dans un CSV.
MAX_CSV_ROWS="10000"
# Nombre maximal de pages dans un PDF.
MAX_PDF_PAGES="30"
# Durée de validité d'un aperçu d'import, en minutes.
IMPORT_PREVIEW_TTL_MINUTES="30"
# Répertoire de travail des fichiers importés. Vide = dossier temporaire du
# système. Le fichier source y est supprimé immédiatement après traitement.
IMPORT_TEMP_DIR=""

# --- Comparateur : administration (specs/comparateur-et-assistant-ia.md A.8) -
# Liste blanche d'adresses administratrices, séparées par des virgules. Le rôle
# est déterminé exclusivement côté serveur, jamais par un champ envoyé par le
# client. Vide = aucune route d'administration accessible.
ADMIN_EMAILS=""

# --- Assistant IA borné (specs/comparateur-et-assistant-ia.md) ---------------
# 3 usages autorisés uniquement (CLAUDE.md §5.6). Clé jamais exposée au mobile :
# aucune variable préfixée NEXT_PUBLIC_ ou EXPO_PUBLIC_ ne doit porter cette clé.
# "none" (défaut) désactive l'IA ; l'application reste intégralement utilisable.
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MAX_OUTPUT_TOKENS="512"
AI_REQUEST_TIMEOUT_MS="15000"
# Crédits mensuels par offre (matrice specs/paiement-in-app.md §2).
AI_MONTHLY_CREDITS_FREE="3"
AI_MONTHLY_CREDITS_PLUS="30"

# --- Paiement in-app (specs/paiement-in-app.md §3) ---------------------------
# Aucune passerelle de paiement web : la facturation passe exclusivement par
# Google Play Billing et Apple StoreKit. Aucun de ces secrets n'est exposé à
# apps/mobile. Un store non configuré rend simplement l'achat invérifiable :
# aucun plan n'est alors accordé.
GOOGLE_PLAY_PACKAGE_NAME=""
# Clé de compte de service, JSON complet tel que fourni par Google.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PLUS_MONTHLY_PRODUCT_ID=""
GOOGLE_PLAY_PLUS_YEARLY_PRODUCT_ID=""
# Jeton de vérification des notifications Pub/Sub (paramètre ?token= de l'URL
# d'abonnement). Vide = aucune notification Google n'est acceptée.
GOOGLE_PLAY_PUBSUB_VERIFICATION_TOKEN=""

APP_STORE_BUNDLE_ID=""
APP_STORE_ISSUER_ID=""
APP_STORE_KEY_ID=""
# Clé privée ES256 de l'App Store Server API, au format PEM.
APP_STORE_PRIVATE_KEY=""
APP_STORE_PLUS_MONTHLY_PRODUCT_ID=""
APP_STORE_PLUS_YEARLY_PRODUCT_ID=""
# Certificat racine Apple (DER en base64), publié par Apple. Vide = aucune
# notification App Store n'est acceptée.
APP_STORE_ROOT_CA=""
# "true" pour viser le bac à sable de l'App Store Server API.
APP_STORE_SANDBOX="false"

# Secret du job de secours d'expiration (POST /api/billing/expire-overdue,
# déclenché par le planificateur de la plateforme). Vide = route injoignable.
BILLING_CRON_SECRET=""
