# Dépendances
node_modules/
.npm/

# Build
.next/
out/
dist/
build/
.expo/
*.tsbuildinfo

# Projets natifs — sortie de `expo prebuild`, régénérée à chaque build EAS à
# partir de `app.config.ts` (CNG). Les conserver dans le dépôt fait sauter
# l'étape de prebuild : la configuration native se fige et toute modification
# ultérieure de `app.config.ts` est silencieusement ignorée (CLAUDE.md §10.12).
apps/mobile/android/
apps/mobile/ios/

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Environnement — aucun secret réel n'est committé (voir .env.example)
.env
.env.*
!.env.example

# Logs / caches / OS
*.log
npm-debug.log*
coverage/
.DS_Store
Thumbs.db

# Éditeurs
.idea/
.vscode/*
!.vscode/extensions.json

# Genere par `next build`, jamais edite a la main.
next-env.d.ts
